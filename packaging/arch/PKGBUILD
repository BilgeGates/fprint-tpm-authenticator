# Builds the working tree. Release packages use packaging/aur.
pkgname=fprint-tpm-authenticator
pkgver=0.2.0
pkgrel=1
pkgdesc="FIDO2 security key for Linux browsers using a fingerprint reader and TPM 2.0"
arch=('x86_64')
license=('GPL-3.0-or-later')
depends=('glibc' 'systemd-libs' 'tpm2-tss' 'libcbor' 'openssl' 'fprintd' 'qt6-base')
makedepends=('cmake' 'pkgconf' 'systemd')
checkdepends=('libfido2' 'swtpm' 'dbus')
optdepends=('libfido2: fpta-hw-check and fpta-security-check'
            'python: fpta-security-check')
install=fpta.install
options=('!debug')

build() {
    cmake -S "$startdir/../.." -B build -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBEXECDIR=lib
    cmake --build build
}

check() {
    ctest --test-dir build --output-on-failure
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 "$startdir/../../LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
